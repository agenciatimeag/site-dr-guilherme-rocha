     "url": "https://www.who.int/news-room/fact-sheets/detail/menopause"
    },
    {
     "title": "The 2022 hormone therapy position statement of The North American Menopause Society, Menopause, 2022",
     "url": "https://pubmed.ncbi.nlm.nih.gov/35797481/"
    },
    {
     "title": "The 2023 nonhormone therapy position statement of The North American Menopause Society, Menopause, 2023",
     "url": "https://pubmed.ncbi.nlm.nih.gov/37252752/"
    },
